root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{css,html,yaml}]
indent_size = 2
indent_style = space

[*.rs]
indent_size = 4
indent_style = space
