watch_file rust-toolchain.toml

if has nix; then
    use flake ./nix
fi

if [ ! -d node_modules ]; then
    bun install
fi

ln -sf $(which bun) "$PWD/node_modules/.bin/node"

PATH_add "$PWD/node_modules/.bin"
