source_up

if [ ! -d node_modules ]; then
    bun install
fi

if [ ! -f dist/index.js ] || [ ! -f dist/index.css ]; then
    bun build assets/js/index.js --outdir dist --minify
    bun build assets/css/index.css --outdir dist --minify
fi

ln -sf "$(which bun)" "$PWD/node_modules/.bin/node"

PATH_add "$PWD/node_modules/.bin"
